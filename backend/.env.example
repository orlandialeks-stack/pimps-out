# Copy to backend/.env and fill in your own values
MONGO_URL="mongodb://localhost:27017"
DB_NAME="pimpsout"
CORS_ORIGINS="*"
JWT_SECRET="<generate: openssl rand -hex 32>"
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD="<choose-a-strong-password>"
FRONTEND_URL="http://localhost:3000"

# AI assistant (Emergent Universal Key, or your own OpenAI key if self-hosting)
EMERGENT_LLM_KEY=""

# Stripe (test or live keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_ACCOUNT_ID=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MODE="test"
